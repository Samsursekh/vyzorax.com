# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PUBLIC_DOMAIN: Primary website production domain name
PUBLIC_DOMAIN="vyzorax.com"

# CSRF_SECRET: Secret key for signing anti-CSRF validation tokens
CSRF_SECRET="vyzorax_secure_csrf_secret_key_2026"

# RATE_LIMIT_WINDOW_MS: Window for rate limiting in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# RATE_LIMIT_MAX_REQUESTS: Max allowed API requests per IP per window
RATE_LIMIT_MAX_REQUESTS=30

# SMTP Configuration for Nodemailer (Contact Form Submissions & Auto-Responder)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="contact@vyzorax.com"
SMTP_PASS=""
ADMIN_EMAIL="contact@vyzorax.com"

# Phase 11 — Analytics Integration
# 1. Google Analytics 4 (GA4) Measurement ID (e.g., G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=""

# 2. Microsoft Clarity Project ID (Optional)
VITE_CLARITY_PROJECT_ID=

# 3. Google Tag Manager (GTM) Container ID (Optional)
VITE_GTM_CONTAINER_ID=""


